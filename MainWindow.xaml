<Window
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" mc:Ignorable="d" x:Class="TwoDecksWPF.MainWindow"
        x:ClassModifier="public"
        Title="Two Decks"
        Width="400"
        Height="450">
    
    <Window.Resources>
        <local:Deck x:Key="leftDeck"/>
        <local:Deck x:Key="rightDeck"/>
    </Window.Resources>
    
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition/>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        
        <Label x:Name="deck1Label" Content="Deck _1" Margin="10,0,0,0" Target="{Binding ElementName=leftDeckListBox, Mode=OneWay}"/>
        <Label x:Name="deck2Label" Grid.Column="1" Content="Deck _2" Margin="10,0,0,0" Target="{Binding ElementName=rightDeckListBox, Mode=OneWay}"/>

        <ListBox x:Name="leftDeckListBox" Grid.Row="1" Margin="10,0,10,10" ItemsSource="{DynamicResource leftDeck}" 
                 MouseDoubleClick="leftDeckListBox_MouseDoubleClick" KeyDown="leftDeckListBox_KeyDown"/>
        <ListBox x:Name="rightDeckListBox" Grid.Column="1" Grid.Row="1" Margin="10,0,10,10" ItemsSource="{DynamicResource rightDeck}"
                 MouseDoubleClick="rightDeckListBox_MouseDoubleClick" KeyDown="rightDeckListBox_KeyDown"/>
        
        <Button x:Name="shuffleLeftDeck" Content="_Shuffle" Grid.Row="2" Margin="10,0,10,10" Click="shuffleLeftDeck_Click"/>
        <Button x:Name="resetLeftDeck" Content="_Reset" Grid.Row="3" Margin="10,0,10,10" Click="resetLeftDeck_Click"/>
        <Button x:Name="clearRightDeck" Grid.Column="1" Content="_Clear" Grid.Row="2" Margin="10,0,10,10" Click="clearRightDeck_Click"/>
        <Button x:Name="sortRightDeck" Grid.Column="1" Content="Sor_t" Grid.Row="3" Margin="10,0,10,10" Click="sortRightDeck_Click"/>
    </Grid>

</Window>